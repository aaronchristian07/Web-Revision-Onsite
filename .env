# Postgres Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=321456
POSTGRES_DB=postgres

# Database Port
DB_STRING="host=localhost user=postgres password=321456 dbname=postgres port=5432"
DB_PORT=5432

# PgPool Configuration
PGPOOL_PCP_USER=pgpool_pcp_user
PGPOOL_PCP_PASSWORD=pgool_pcp_secret123

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=secret321

# NGINX Configuration
NGINX_PORT=80

# Frontend Configuration
# VITE_API_URL is relative on purpose: the browser hits nginx, which proxies
# /api/* to the backends. Keeps the app same-origin, so no CORS setup needed.
FRONTEND_PORT=5173
VITE_API_URL=/api

# Ice Service Configuration
# NOTE: nginx.conf pins the ice upstream to 8002. If you change this, update
# the `set $ice_upstream` line in nginx/nginx.conf to match.
ICE_SERVICE_PORT=8002

# Payment Service Configuration
PAYMENT_SERVICE_PORT=8003


# SeaweedFS (Object Storage) Configuration
SEAWEED_S3_ENDPOINT=seaweedfs:8333
SEAWEED_S3_PUBLIC_ENDPOINT=http://localhost:8333
SEAWEED_ACCESS_KEY=iceservice
SEAWEED_SECRET_KEY=iceservicesecret123
SEAWEED_BUCKET=ice-cream-images
SEAWEED_PROFILE_BUCKET=profile-images

# JWT Configuration
JWT_SECRET=kelompokehhh321