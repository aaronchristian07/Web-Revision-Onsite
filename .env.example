# Copy to .env and fill in the placeholder values:
#   cp .env.example .env
#
# .env is gitignored - never commit real credentials.
# Ports and hostnames below are working defaults; only the <...> values
# need choosing.

# Postgres Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<choose-a-password>
POSTGRES_DB=postgres

# Database Port
# DB_STRING here is only used when running a service directly on your host.
# docker compose overrides it with host=pgpool for the containers.
DB_STRING="host=localhost user=postgres password=<same-as-POSTGRES_PASSWORD> dbname=postgres port=5432"
DB_PORT=5432

# PgPool Configuration
PGPOOL_PCP_USER=pgpool_pcp_user
PGPOOL_PCP_PASSWORD=<choose-a-password>

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=<choose-a-password>

# NGINX Configuration
# The gateway port. Open the app at http://localhost:${NGINX_PORT}
NGINX_PORT=80

# Frontend Configuration
# VITE_API_URL is relative on purpose: the browser hits nginx, which proxies
# /api/* to the backends. Keeps the app same-origin, so no CORS setup needed.
FRONTEND_PORT=5173
VITE_API_URL=/api

# Ice Service Configuration
# NOTE: nginx.conf pins the ice upstream to 8002. If you change this, update
# the `set $ice_upstream` line in nginx/nginx.conf to match.
ICE_SERVICE_PORT=8002

# SeaweedFS (Object Storage) Configuration
# ACCESS_KEY and SECRET_KEY must match the identity in seaweed/s3-config.json,
# which is committed - change both places together or uploads will 403.
SEAWEED_S3_ENDPOINT=seaweedfs:8333
SEAWEED_S3_PUBLIC_ENDPOINT=http://localhost:8333
SEAWEED_ACCESS_KEY=<must-match-seaweed/s3-config.json>
SEAWEED_SECRET_KEY=<must-match-seaweed/s3-config.json>
SEAWEED_BUCKET=ice-cream-images

# JWT Configuration
# Signing key for access tokens. Use a long random string.
JWT_SECRET=<choose-a-long-random-string>
